:{$PORT:8080}

# Permanent domain migration. Keep the full path/query intact.
@old-domain host axisscaffolding.co.uk www.axisscaffolding.co.uk
redir @old-domain https://axisscaffoldingessex.co.uk{uri} permanent

root * /app

# Clean URL routing — serve {path}/index.html for any path that isn't a direct file
@notfile not file
rewrite @notfile {path}/index.html

file_server

# Cache headers
header /assets/* Cache-Control "public, max-age=31536000, immutable"
header /*.html   Cache-Control "public, max-age=0, must-revalidate"

# 404 fallback
handle_errors {
    rewrite * /404.html
    file_server
}
