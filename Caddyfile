:{$PORT:8080}

root * /app

# Clean URL routing — serve {path}/index.html for any path that isn't a direct file
@notfile not file
rewrite @notfile {path}/index.html

file_server

# Cache headers
header /assets/* Cache-Control "public, max-age=31536000, immutable"
header /*.html   Cache-Control "public, max-age=0, must-revalidate"

# 404 fallback
handle_errors {
    rewrite * /404.html
    file_server
}
